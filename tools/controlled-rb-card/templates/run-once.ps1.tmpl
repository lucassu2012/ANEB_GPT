param([switch]$ValidateOnly)
# Pure ASCII PowerShell 5.1 source.
$ErrorActionPreference = 'Stop'
$root = '{{CARD_ROOT}}'
$outerLocks = @()
try {
 foreach ($spec in @(
  @('common.ps1',                  '{{COMMON_SHA256}}'),
  @('execute-once.ps1',            '{{EXECUTE_ONCE_SHA256}}'),
  @('verify-cleanup-readonly.ps1', '{{VERIFY_CLEANUP_SHA256}}')
 )) {
  $p = Join-Path $root $spec[0]
  $f = [IO.File]::Open($p, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
  $outerLocks += $f
  $h = [Security.Cryptography.SHA256]::Create()
  try {
   $s = [BitConverter]::ToString($h.ComputeHash($f)).Replace('-', '').ToLowerInvariant()
  } finally {
   $h.Dispose()
  }
  if ($s -cne $spec[1]) { throw ('Fixed R/B card script drift: ' + $spec[0]) }
 }
 . (Join-Path $root 'common.ps1')
 if ($ValidateOnly) {
  & $ps5 -NoProfile -NonInteractive -InputFormat None -File (Join-Path $root 'execute-once.ps1') -ValidateOnly
  exit $LASTEXITCODE
 }
 $origin = Read-AnebAuthorizedAdminOrigin
 foreach ($n in @('runtime', 'OUTER_INTENT.json', 'OUTER_RESULT.json')) {
  if (Test-Path -LiteralPath (Join-Path $root $n)) {
   throw 'Controlled R/B card already consumed; do not repeat'
  }
 }
 Save-New (Join-Path $root 'OUTER_INTENT.json') @{
  utc                           = [DateTime]::UtcNow.ToString('o')
  po                            = '{{CARD_PO}}'
  origin                        = $origin
  in_job                        = [bool]$origin.in_job
  po_agent_host_authorized      = $true
  control_and_cleanup_budget_ms = $outerBudgetMs
  no_self_elevation             = $true
  old_receipts_unchanged        = $true
 }
 $outerQpcStart = [Diagnostics.Stopwatch]::GetTimestamp()
 $outerClock = [Diagnostics.Stopwatch]::StartNew()
 $outerDeadlineTicks = $outerQpcStart + [long][Math]::Floor(($outerBudgetMs / 1000.0) * [Diagnostics.Stopwatch]::Frequency)
 $r = [ordered]@{
  format                   = '{{OUTER_FORMAT}}'
  actual_exit_code         = $null
  actual_exit_observed     = $false
  worker_pass              = $false
  pass                     = $false
  failure                  = $null
  independent_cleanup_pass = $false
 }
 $job = $null
 $verifyJob = $null
 try {
  Write-Host '{{CARD_BANNER}}'
  Write-Host '[OPERATOR NOTICE] Keep P40 Pro unlocked on Huawei Launcher. PO authorized verified visible-UI confirmation of the Android screen-capture consent dialog (no appops bypass) for R and B.'
  $job = Start-Owned $ps5 @('-NoProfile', '-NonInteractive', '-InputFormat', 'None', '-File', (Join-Path $root 'execute-once.ps1'))
  $v = Finish-Owned $job $outerBudgetMs
  $r.actual_exit_code = $v.actual_exit_code
  $r.actual_exit_observed = $v.actual_exit_observed
  $r.process_receipt = $v
  $t = Read-JSON (Join-Path $runtime 'TERMINAL.json')
  $r.worker_pass = $t.pass -is [bool] -and $t.pass
  $r.worker_failure = $t.failure
  $r.worker_cleanup_errors = $t.cleanup_errors
  $left = [int][Math]::Max(0, [Math]::Floor(1000.0 * ($outerDeadlineTicks - [Diagnostics.Stopwatch]::GetTimestamp()) / [Diagnostics.Stopwatch]::Frequency))
  if ($left -le 0) { throw 'Outer 900s budget exhausted; independent cleanup read NOT_RUN' }
  $verifyJob = Start-Owned $ps5 @('-NoProfile', '-NonInteractive', '-InputFormat', 'None', '-File', (Join-Path $root 'verify-cleanup-readonly.ps1'), '-ParentDeadlineTicks', ([string]$outerDeadlineTicks), '-ParentDeadlineFrequency', ([string][Diagnostics.Stopwatch]::Frequency))
  $iv = Finish-Owned $verifyJob $left
  $r.independent_cleanup_process = $iv
  $ic = Read-JSON (Join-Path $root 'INDEPENDENT_CLEANUP.json')
  $r.independent_cleanup_pass = $iv.actual_exit_code -eq 0 -and $ic.all_checked_true -eq $true
  $r.pass = $r.actual_exit_observed -and $null -ne $r.actual_exit_code -and $r.actual_exit_code -eq 0 -and $r.worker_pass -and $r.independent_cleanup_pass -and $outerClock.ElapsedMilliseconds -le $outerBudgetMs
 } catch {
  $r.failure = $_.Exception.GetType().FullName + ':' + $_.Exception.Message
  if ($job) { $r.partial_process_receipt = Partial-Owned $job $r.failure }
  if ($verifyJob) { $r.partial_independent_cleanup_process = Partial-Owned $verifyJob $r.failure }
 } finally {
  if ($job) { $job.process.Dispose() }
  if ($verifyJob) { $verifyJob.process.Dispose() }
  $r.outer_elapsed_ms = $outerClock.ElapsedMilliseconds
  $r.finished_utc = [DateTime]::UtcNow.ToString('o')
  Save-New (Join-Path $root 'OUTER_RESULT.json') $r
 }
 Write-Host ('Controlled R/B outer pass: ' + $r.pass + '; inspect raw R/B bundles for independent media and LoadedResponsiveness review.')
 Write-Host ('Receipt: ' + (Join-Path $root 'OUTER_RESULT.json'))
 Write-Host 'Preserve all originals and partial receipts. Do not repeat.'
 if (-not $r.pass) { exit 2 }
 exit 0
} finally {
 foreach ($f in $outerLocks) { $f.Dispose() }
 if ($pins) { foreach ($f in $pins) { $f.Dispose() } }
}
