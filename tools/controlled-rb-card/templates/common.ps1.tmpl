function Read-JSON($path) {
 $f = [IO.File]::OpenRead($path)
 try {
  if ($f.Length -gt 2097152) { throw 'JSON exceeds 2MiB' }
  $r = [IO.StreamReader]::new($f, [Text.Encoding]::UTF8)
  try {
   return ($r.ReadToEnd() | ConvertFrom-Json -ErrorAction Stop)
  } finally {
   $r.Dispose()
  }
 } finally {
  $f.Dispose()
 }
}

function Get-AnebPhaseInstrumentationConditionArgs([string]$ConditionId, $SavedRequest) {
 if ($ConditionId -cnotin @('R', 'B')) {
  throw ('Unsupported condition_id for instrumentation args: ' + $ConditionId)
 }
 if ($ConditionId -ceq 'R') {
  return @()
 }
 if ($null -eq $SavedRequest -or $null -eq $SavedRequest.downlink_ip_bytes_per_second) {
  throw 'Saved request.json missing downlink_ip_bytes_per_second for phase B'
 }
 $rate = [uint64]$SavedRequest.downlink_ip_bytes_per_second
 if ($rate -le 0) {
  throw ('Saved request.json downlink_ip_bytes_per_second must be positive for phase B, got: ' + $rate)
 }
 return @('-e', 'host_downlink_ip_bytes_per_second', ([string]$rate))
}

function Assert-AnebPhaseResultConditionMatch([string]$ConditionId, $DevResult, $SavedRequest) {
 if ($ConditionId -cnotin @('R', 'B')) {
  throw ('Unsupported condition_id for result provenance check: ' + $ConditionId)
 }
 if ($null -eq $DevResult -or $null -eq $DevResult.hostNetworkCondition) {
  throw ('Device result missing hostNetworkCondition in condition ' + $ConditionId)
 }
 if ($ConditionId -ceq 'B') {
  $expectedRate = [uint64]$SavedRequest.downlink_ip_bytes_per_second
  $actualRateText = [string]$DevResult.hostNetworkCondition.downlinkIpBytesPerSecond
  if ($actualRateText -cne ([string]$expectedRate)) {
   throw ('Device result downlinkIpBytesPerSecond mismatch in condition B: got ' + $actualRateText + ', expected ' + $expectedRate)
  }
 }
}

function Assert-AnebDoubaoUiBinding([string]$JsonText, [string]$ExpectedSha256 = '') {
 if ([string]::IsNullOrWhiteSpace($JsonText)) { throw 'Doubao UI binding JSON text missing' }
 $utf8Bytes = [Text.UTF8Encoding]::new($false).GetBytes($JsonText)
 $h = [Security.Cryptography.SHA256]::Create()
 try {
  $actualSha = [BitConverter]::ToString($h.ComputeHash($utf8Bytes)).Replace('-', '').ToLowerInvariant()
 } finally {
  $h.Dispose()
 }
 if (-not [string]::IsNullOrWhiteSpace($ExpectedSha256) -and $actualSha -cne $ExpectedSha256) {
  throw ('Doubao UI binding UTF-8 SHA256 mismatch: expected ' + $ExpectedSha256 + ', got ' + $actualSha)
 }
 $b = $JsonText | ConvertFrom-Json -ErrorAction Stop
 if ([string]$b.observation_method -cne 'doubao-public-selectors-1') {
  throw 'Doubao UI binding observation_method must be doubao-public-selectors-1'
 }
 if ([string]$b.package_name -cne 'com.larus.nova') {
  throw 'Doubao UI binding package_name must be com.larus.nova'
 }
 if ([int64]$b.app_version_code -le 0) {
  throw 'Doubao UI binding app_version_code must be positive'
 }
 if ([int]$b.display_width -ne 1200 -or [int]$b.display_height -ne 2640 -or [int]$b.rotation -ne 0) {
  throw 'Doubao UI binding display geometry must be 1200x2640 rotation 0'
 }
 if ($null -eq $b.selectors -or [string]::IsNullOrWhiteSpace([string]$b.selectors.edit_text_id) -or [string]::IsNullOrWhiteSpace([string]$b.selectors.send_button_id) -or [string]::IsNullOrWhiteSpace([string]$b.selectors.send_button_desc) -or [string]::IsNullOrWhiteSpace([string]$b.selectors.new_chat_id_contains) -or [string]::IsNullOrWhiteSpace([string]$b.selectors.message_list_id)) {
  throw 'Doubao UI binding selectors incomplete'
 }
 if ([string]::IsNullOrWhiteSpace([string]$b.prompt)) {
  throw 'Doubao UI binding prompt missing'
 }
 return [ordered]@{
  valid            = $true
  sha256           = $actualSha
  query_plan_count = 5
 }
}

function Import-PinnedFunctions($path, [string[]]$names) {
 $tokens = $null; $errors = $null
 $ast = [Management.Automation.Language.Parser]::ParseFile($path, [ref]$tokens, [ref]$errors)
 if ($errors.Count) { throw 'Pinned function parse failure' }
 foreach ($name in $names) {
  $found = @($ast.FindAll({ param($n) $n -is [Management.Automation.Language.FunctionDefinitionAst] -and $n.Name -ceq $name }, $true))
  if ($found.Count -ne 1) { throw ('Exactly one named function required: ' + $name) }
  $definition = $found[0].Extent.Text -replace ('^function\s+' + [regex]::Escape($name)), ('function script:' + $name)
  . ([scriptblock]::Create($definition))
 }
}

