function Save-New($path, $value) {
 $f = [IO.File]::Open($path, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
 try {
  $b = [Text.UTF8Encoding]::new($false).GetBytes(($value | ConvertTo-Json -Depth 16) + "`n")
  $f.Write($b, 0, $b.Length)
  $f.Flush($true)
 } finally {
  $f.Dispose()
 }
}

function Pin-File($path, $sha) {
 $f = [IO.File]::Open($path, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
 $script:pins += $f
 $h = [Security.Cryptography.SHA256]::Create()
 try {
  $actual = [BitConverter]::ToString($h.ComputeHash($f)).Replace('-', '').ToLowerInvariant()
 } finally {
  $h.Dispose()
 }
 if ($actual -cne $sha) { throw ('Pinned file drift: ' + $path + ' (got ' + $actual + ')') }
}

