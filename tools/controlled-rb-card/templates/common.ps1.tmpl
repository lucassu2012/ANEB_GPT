function Read-AnebAuthorizedAdminOrigin {
 $process = [Diagnostics.Process]::GetCurrentProcess()
 try { $actualExe = $process.MainModule.FileName } finally { $process.Dispose() }
 $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
 try {
  $principal = [Security.Principal.WindowsPrincipal]::new($identity)
  $isAdmin = $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
  $h = [Security.Cryptography.SHA256]::Create()
  try {
   $sid = [BitConverter]::ToString($h.ComputeHash([Text.Encoding]::UTF8.GetBytes($identity.User.Value))).Replace('-', '').ToLowerInvariant()
  } finally {
   $h.Dispose()
  }
 } finally {
  $identity.Dispose()
 }
 $ctx = [AnebOwnContextInventory]::Context()
 $tf = [AnebTwoTokenFields]::Read()
 $parents = @(); $current = [int]$PID; $previous = $null
 for ($i = 0; $i -lt 12; $i++) {
  $p = $null
  try { $p = Get-CimInstance Win32_Process -Filter "ProcessId=$current" -ErrorAction Stop } catch { $p = $null }
  if ($null -eq $p -or $null -eq $p.CreationDate) { break }
  $created = [datetime]$p.CreationDate
  if ($null -ne $previous -and $created -gt $previous) { break }
  $parents += , [ordered]@{
   pid         = [int]$p.ProcessId
   parent_pid  = [int]$p.ParentProcessId
   name        = [string]$p.Name
   exe         = [string]$p.ExecutablePath
   created_utc = $created.ToUniversalTime().ToString('o')
  }
  if ($p.ParentProcessId -le 0 -or $p.ParentProcessId -eq $current) { break }
  $previous = $created; $current = [int]$p.ParentProcessId
 }
 $origin = [ordered]@{
  pid                      = $PID
  pointer_size             = [IntPtr]::Size
  actual_exe               = $actualExe
  is_admin                 = [bool]$isAdmin
  user_sid_sha256          = $sid
  in_job                   = [bool]$ctx.in_job
  po_agent_host_authorized = $true
  context                  = $ctx
  two_fields               = $tf
  parents                  = $parents
 }
 return (Assert-AnebAuthorizedAdminOrigin $origin)
}

if (-not ('AnebCalibrationExit' -as [type])) {
 Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public static class AnebCalibrationExit {[DllImport("kernel32.dll",SetLastError=true)]public static extern bool GetExitCodeProcess(IntPtr handle,out uint code);}'
}

function Start-Owned($file, [string[]]$arguments) {
 $psi = [Diagnostics.ProcessStartInfo]::new()
 $psi.FileName = $file
 $psi.Arguments = (@($arguments | ForEach-Object { '"' + ($_.Replace('"', '\"')) + '"' }) -join ' ')
 $psi.UseShellExecute = $false
 $psi.CreateNoWindow = $true
 $psi.RedirectStandardOutput = $true
 $psi.RedirectStandardError = $true
 $p = [Diagnostics.Process]::new()
 $p.StartInfo = $psi
 $c = [Diagnostics.Stopwatch]::StartNew()
 if (-not $p.Start()) { throw 'Own process start refused' }
 $h = $p.Handle
 if ($h -eq [IntPtr]::Zero) { throw 'No original process HANDLE' }
 return @{
  process = $p
  handle  = $h
  clock   = $c
  stdout  = $p.StandardOutput.ReadToEndAsync()
  stderr  = $p.StandardError.ReadToEndAsync()
  pid     = $p.Id
 }
}

function Finish-Owned($job, [int]$budget) {
 $left = [int][Math]::Max(0, $budget - $job.clock.ElapsedMilliseconds)
 if ($left -eq 0 -or -not $job.process.WaitForExit($left)) {
  throw 'Own process not exited within original budget; UNKNOWN, no PID kill or resend'
 }
 $code = [uint32]0
 $ok = [AnebCalibrationExit]::GetExitCodeProcess($job.handle, [ref]$code)
 $errorCode = [Runtime.InteropServices.Marshal]::GetLastWin32Error()
 if (-not $ok) { throw ('Actual exit query failed: ' + $errorCode) }
 $texts = @()
 foreach ($task in @($job.stdout, $job.stderr)) {
  $left = [int][Math]::Max(0, $budget - $job.clock.ElapsedMilliseconds)
  if (-not $task.IsCompleted -and ($left -eq 0 -or -not $task.Wait($left))) {
   throw 'Output incomplete at original deadline'
  }
  $texts += , $task.GetAwaiter().GetResult()
 }
 if ($job.clock.ElapsedMilliseconds -gt $budget) { throw 'Original process/output budget exceeded' }
 return [ordered]@{
  pid                     = $job.pid
  actual_exit_observed    = $true
  native_exit_query_ok    = $ok
  native_exit_query_error = 0
  actual_exit_code        = $code
  elapsed_ms              = $job.clock.ElapsedMilliseconds
  stdout                  = $texts[0]
  stderr                  = $texts[1]
 }
}

function Partial-Owned($job, $failure) {
 $v = [ordered]@{
  pid                  = $job.pid
  elapsed_ms           = $job.clock.ElapsedMilliseconds
  failure              = $failure
  actual_exit_observed = $false
  actual_exit_code     = $null
  stdout_state         = 'NOT_READY_NO_WAIT'
  stderr_state         = 'NOT_READY_NO_WAIT'
 }
 try {
  if ($job.process.HasExited) {
   $v.actual_exit_observed = $true
   $code = [uint32]0
   $ok = [AnebCalibrationExit]::GetExitCodeProcess($job.handle, [ref]$code)
   $v.native_exit_query_ok = $ok
   if ($ok) { $v.actual_exit_code = $code }
  }
 } catch {
  $v.exit_read_failure = $_.Exception.Message
 }
 foreach ($name in @('stdout', 'stderr')) {
  try {
   if ($job[$name].IsCompleted) {
    $v[$name] = $job[$name].GetAwaiter().GetResult()
    $v[$name + '_state'] = 'CAPTURED_WITHOUT_WAIT'
   }
  } catch {
   $v[$name + '_failure'] = $_.Exception.Message
  }
 }
 return $v
}

function Adb($name, [string[]]$arguments, [int]$budget = 10000) {
 if ($cleanupClock) { $budget = [int][Math]::Min($budget, [Math]::Max(0, $cleanupBudgetMs - $cleanupClock.ElapsedMilliseconds)) }
 if ($connectionClock) { $budget = [int][Math]::Min($budget, [Math]::Max(0, 30000 - $connectionClock.ElapsedMilliseconds)) }
 if ($budget -le 0) { throw 'Bounded connection/cleanup clock exhausted before ADB' }
 $budget = Get-AnebReadBudget $budget
 $script:commandNumber++
 $path = Join-Path $runtime ('adb-' + $script:commandNumber.ToString('D3') + '-' + $name + '.json')
 $j = Start-Owned $adb (@('-s', $serial) + $arguments)
 $retained = $false
 try {
  $v = Finish-Owned $j $budget
  Save-New $path $v
  if ($v.actual_exit_code -ne 0) { throw ('ADB actual exit nonzero: ' + $name) }
  return $v.stdout
 } catch {
  if (-not (Test-Path -LiteralPath $path)) { Save-New $path (Partial-Owned $j $_.Exception.Message) }
  if (-not $j.process.HasExited) { $script:unresolvedAdb += , $j; $retained = $true }
  throw
 } finally {
  if (-not $retained) { $j.process.Dispose() }
 }
}

function Phone-Clean($prefix) {
 if ((Adb ($prefix + 'online') @('get-state')).Trim() -cne 'device') { throw 'P40 offline' }
 $window = Adb ($prefix + 'focus') @('shell', 'dumpsys', 'window')
 if ($window -notmatch 'mCurrentFocus=.*com\.huawei\.android\.launcher/') { throw 'Not Huawei Launcher' }
 $p = Adb ($prefix + 'processes') @('shell', 'ps', '-A', '-o', 'PID,NAME')
 if ($p -notmatch '\bPID\b.*\bNAME\b' -or $p -match 'com\.aneb\.probe|com\.huawei\.himovie\b|deepseek|moonshot|kimichat|qwen|aweme|com\.larus\.nova|screenrecord|scrcpy|httpcanary|remote_capture|tun2socks') {
  throw 'Unknown conflicting session untouched'
 }
 $activeSvcs = Adb ($prefix + 'aneb-aweme-services') @('shell', 'dumpsys', 'activity', 'services')
 if ($activeSvcs -match 'ServiceRecord\{[^\r\n]*(?:com\.aneb\.probe|com\.ss\.android\.ugc\.aweme|com\.larus\.nova)') {
  throw 'Active ANEB or business ServiceRecord present; not clean'
 }
 $activities = Adb ($prefix + 'settings-activities') @('shell', 'dumpsys', 'activity', 'activities')
 $services = Adb ($prefix + 'settings-services') @('shell', 'dumpsys', 'activity', 'services', 'com.android.settings')
 $present = $p -match '(?m)\scom\.android\.settings\r?$'
 $processDump = ''
 if ($present) { $processDump = Adb ($prefix + 'settings-state') @('shell', 'dumpsys', 'activity', 'processes') }
 if (-not (Test-AnebSettingsIdle $window $activities $services $processDump $present)) {
  throw 'Active or unknown Settings state; do not stop unknown process'
 }
 $n = Adb ($prefix + 'networks') @('shell', 'dumpsys', 'connectivity')
 $a = @($n -split "`n" | Where-Object { $_ -match '^\s*NetworkAgentInfo\{' })
 if ($a.Count -eq 0 -or @($a | Where-Object { $_ -notmatch '\bNOT_VPN\b' -or $_ -match 'Transports:[^\r\n]*\bVPN\b' }).Count) {
  throw 'Unknown VPN/network'
 }
 if ((Adb ($prefix + 'projection') @('shell', 'dumpsys', 'media_projection')) -notmatch '(?s)^MEDIA PROJECTION MANAGER[^\r\n]*\r?\nMedia Projection:\s*null\s*$') {
  throw 'Unknown active MediaProjection'
 }
 if ((Adb ($prefix + 'interfaces') @('shell', 'ls', '/sys/class/net')) -match '(?m)^(tun\d*|ppp\d*|wg\d+|ipsec\d+)\r?$') {
  throw 'Unknown tunnel interface'
 }
 if ((Adb ($prefix + 'alwaysvpn') @('shell', 'settings', 'get', 'secure', 'always_on_vpn_app')).Trim() -cne 'null') {
  throw 'Always-on VPN configured'
 }
}

function Package-Hash($package, $name) {
 $s = (Adb ($name + 'path') @('shell', 'pm', 'path', $package)).Trim()
 if ($s -cnotmatch '^package:(/data/app/[A-Za-z0-9_~=/+.-]+/base\.apk)$') { throw ('Single installed APK required: ' + $package) }
 $path = $Matches[1]
 $s = Adb ($name + 'sha') @('shell', 'sha256sum', $path) 20000
 if ($s -cnotmatch '^([0-9a-f]{64})\s') { throw ('Installed SHA unavailable: ' + $package) }
 return @{ path = $path; sha = $Matches[1] }
}

