 }
}

function Stop-OwnDriver($phase) {
 $cw = if ($cleanupClock) { $cleanupClock } else { [Diagnostics.Stopwatch]::StartNew() }
 $r = [ordered]@{ created = $phase.created; delete_ok = $null; delete_error = $null; removed = $false; failure = $null; handle_errors = @() }
 try {
  if ($phase.created) {
   if ($phase.started -and -not $phase.tree_proved) { throw 'Exact own exit/tree proof missing; no Stop/Delete' }
   if ($cw.ElapsedMilliseconds -ge $cleanupBudgetMs) { throw 'Cleanup budget exhausted before service operation' }
   $s = [AnebOwnedDriver+Status]::new()
   if (-not [AnebOwnedDriver]::QueryServiceStatus($phase.service, [ref]$s)) { throw 'Own service Query failed' }
   if ($s.State -ne 1) {
    if (-not [AnebOwnedDriver]::ControlService($phase.service, 1, [ref]$s) -and [AnebOwnedDriver]::LastError() -ne 1062) {
     throw 'Own service Stop failed'
    }
   }
   while ($s.State -ne 1 -and $cw.ElapsedMilliseconds -lt $cleanupBudgetMs) {
    Start-Sleep -Milliseconds 100
    if (-not [AnebOwnedDriver]::QueryServiceStatus($phase.service, [ref]$s)) { throw 'Own service stop Query failed' }
   }
   if ($s.State -ne 1 -or $cw.ElapsedMilliseconds -ge $cleanupBudgetMs) { throw 'Own STOPPED/deadline missing' }
   $r.delete_ok = [AnebOwnedDriver]::DeleteService($phase.service)
   $r.delete_error = [AnebOwnedDriver]::LastError()
   if (-not $r.delete_ok -and $r.delete_error -ne 1072) { throw 'Own Delete failed' }
   if (-not [AnebOwnedDriver]::CloseServiceHandle($phase.service)) { throw 'Own service HANDLE close failed' }
   $phase.service = [IntPtr]::Zero
   $h = [AnebOwnedDriver]::OpenService($phase.scm, 'WinDivert', 4)
   $e = [AnebOwnedDriver]::LastError()
   if ($h -ne [IntPtr]::Zero) { [void][AnebOwnedDriver]::CloseServiceHandle($h); throw 'Service still present' }
   if ($e -ne 1060) { throw 'Service absence UNKNOWN' }
   $r.removed = $true
  } else {
   $r.no_service_created = $true
  }
 } catch {
  $r.failure = $_.Exception.Message
  if (-not $script:cleanupClock) { $script:cleanupClock = $cw }
 } finally {
  if ($phase.service -ne [IntPtr]::Zero) {
   $r.fallback_service_handle_closed = [AnebOwnedDriver]::CloseServiceHandle($phase.service)
   if (-not $r.fallback_service_handle_closed) { $r.handle_errors += , 'Own fallback HANDLE close failed' }
  }
  if ($phase.scm -ne [IntPtr]::Zero) {
   $r.scm_handle_closed = [AnebOwnedDriver]::CloseServiceHandle($phase.scm)
   if (-not $r.scm_handle_closed) { $r.handle_errors += , 'Own SCM HANDLE close failed' }
  }
  $r.elapsed_ms = $cw.ElapsedMilliseconds
  if ($r.elapsed_ms -gt $cleanupBudgetMs) { $r.handle_errors += , 'Cleanup budget exceeded' }
  if ($r.handle_errors.Count -and -not $script:cleanupClock) { $script:cleanupClock = $cw }
  Save-New (Join-Path $phase.directory 'driver-cleanup.json') $r
 }
 if ($r.failure -or $r.handle_errors.Count -or ($phase.created -and -not $r.removed)) {
  throw ('Own driver cleanup incomplete: ' + $r.failure + '; ' + ($r.handle_errors -join ';'))
 }
}
