{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aneb.local/schemas/aneb-profile-v2.schema.json",
  "title": "ANEB Profile Contract v2",
  "type": "object",
  "required": [
    "contract_version",
    "profile_id",
    "version",
    "mode_id",
    "execution_target",
    "claim_scope",
    "business",
    "measurements",
    "live_presentation",
    "evaluation",
    "phases"
  ],
  "properties": {
    "contract_version": {"const": "aneb-profile-v2"},
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "mode_id": {"type": "string", "minLength": 1},
    "execution_target": {"const": "aneb_probe_simulator"},
    "claim_scope": {"const": "application_end_to_end_to_probe_node"},
    "business": {
      "type": "object",
      "required": ["category_id", "label"],
      "additionalProperties": true
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "live_presentation": {
      "type": "object",
      "required": ["primary_metric_id", "window_ms", "ui_refresh_ms", "missing_behavior"],
      "properties": {
        "primary_metric_id": {"type": "string"},
        "secondary_metric_ids": {"type": "array", "items": {"type": "string"}},
        "window_ms": {"type": "integer", "minimum": 1},
        "ui_refresh_ms": {"type": "integer", "minimum": 16},
        "missing_behavior": {"const": "show_unavailable_never_zero"}
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": ["target_set_id", "score_policy_id", "conclusion_policy_id", "missing_required_metric", "invalid_run"],
      "additionalProperties": true
    },
    "phases": {"type": "array", "minItems": 1}
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": [
        "metric_id",
        "label",
        "domain",
        "unit",
        "measurement_level",
        "formula_id",
        "aggregation",
        "direction",
        "required_for_score",
        "minimum_sample_count",
        "target_role",
        "quality_target"
      ],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "measurement_level": {"enum": ["exact", "derived", "proxy", "unsupported"]},
        "required_for_score": {"type": "boolean"},
        "minimum_sample_count": {"type": "integer", "minimum": 1},
        "quality_target": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

