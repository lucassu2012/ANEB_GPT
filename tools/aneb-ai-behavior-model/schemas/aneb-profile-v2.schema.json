{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aneb.local/schemas/aneb-profile-v2.schema.json",
  "title": "ANEB Profile Contract v2",
  "type": "object",
  "required": [
    "contract_version",
    "profile_id",
    "version",
    "mode_id",
    "execution_target",
    "claim_scope",
    "business",
    "measurements",
    "live_presentation",
    "evaluation",
    "phases"
  ],
  "properties": {
    "contract_version": {"const": "aneb-profile-v2"},
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "mode_id": {"type": "string", "minLength": 1},
    "execution_target": {"const": "aneb_probe_simulator"},
    "claim_scope": {
      "enum": [
        "application_end_to_end_to_probe_node",
        "controlled_server_disconnect_recovery_to_probe_node",
        "application_end_to_end_to_probe_node_through_dedicated_ip_forwarding_gateway",
        "application_end_to_end_to_probe_node_through_dedicated_gateway_with_ip_outage",
        "application_end_to_end_to_probe_node_with_declared_synthetic_http_impairment",
        "application_end_to_end_to_probe_node_with_declared_synthetic_request_outage"
      ]
    },
    "execution_requirements": {"$ref": "#/$defs/execution_requirements"},
    "qualification": {"$ref": "#/$defs/repeatability_qualification_binding"},
    "business": {
      "type": "object",
      "required": ["category_id", "label", "behavior_feature_ids", "calibration_status"],
      "properties": {
        "category_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "archetype_labels": {"type": "array", "items": {"type": "string"}},
        "behavior_feature_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "behavior_model_id": {"type": ["string", "null"]},
        "behavior_model_version": {"type": ["string", "null"]},
        "behavior_model_hash": {"type": ["string", "null"]},
        "calibration_status": {"enum": ["hypothesis", "calibrated", "validated", "retired", "not_applicable"]},
        "model_source_kind": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"calibration_status": {"const": "not_applicable"}}},
          "then": {
            "properties": {
              "behavior_model_id": {"type": "null"},
              "behavior_model_version": {"type": "null"},
              "behavior_model_hash": {"type": "null"},
              "model_source_kind": {"type": "null"}
            }
          },
          "else": {
            "required": ["behavior_model_id", "behavior_model_hash"],
            "properties": {
              "behavior_model_id": {"type": "string", "minLength": 1},
              "behavior_model_hash": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "live_presentation": {
      "type": "object",
      "required": ["primary_metric_id", "secondary_metric_ids", "window_ms", "ui_refresh_ms", "stale_after_ms", "missing_behavior"],
      "properties": {
        "primary_metric_id": {"type": "string", "minLength": 1},
        "secondary_metric_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "window_ms": {"type": "integer", "minimum": 1},
        "ui_refresh_ms": {"type": "integer", "minimum": 16},
        "stale_after_ms": {"type": "integer", "minimum": 16},
        "missing_behavior": {"const": "show_unavailable_never_zero"}
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": [
        "target_set_id",
        "score_policy_id",
        "conclusion_policy_id",
        "required_metric_ids",
        "guardrail_metric_ids",
        "group_weights",
        "missing_required_metric",
        "invalid_run"
      ],
      "properties": {
        "target_set_id": {"type": "string", "minLength": 1},
        "score_policy_id": {"type": "string", "minLength": 1},
        "conclusion_policy_id": {"type": "string", "minLength": 1},
        "required_metric_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "guardrail_metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "group_weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "grade_bands": {"type": "object", "additionalProperties": {"type": "number"}},
        "missing_required_metric": {"const": "score_null"},
        "invalid_run": {"const": "retain_raw_suppress_score"}
      },
      "additionalProperties": true
    },
    "phases": {"type": "array", "minItems": 1}
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "repeatability_qualification_binding": {
      "type": "object",
      "required": [
        "contract_version",
        "policy_id",
        "policy_version",
        "decision_id",
        "policy_sha256",
        "stage_order",
        "transport_pooling",
        "q2_requires_q1_pass",
        "runs_per_family",
        "repeatability_and_quality_gates_independent",
        "formal_baseline_eligible",
        "single_run_confidence_unchanged"
      ],
      "properties": {
        "contract_version": {"const": "aneb-repeatability-profile-binding-v1"},
        "policy_id": {"const": "aneb-repeatability-qualification-balanced-v1"},
        "policy_version": {"const": "1.0.0"},
        "decision_id": {"const": "D-110"},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stage_order": {
          "const": ["Q1_WIFI", "Q2_CELLULAR"]
        },
        "transport_pooling": {"const": "forbidden"},
        "q2_requires_q1_pass": {"const": true},
        "runs_per_family": {"const": 10},
        "repeatability_and_quality_gates_independent": {"const": true},
        "formal_baseline_eligible": {"const": false},
        "single_run_confidence_unchanged": {"const": true}
      },
      "additionalProperties": false
    },
    "server_primitive": {
      "oneOf": [
        {
          "type": "object",
          "required": ["primitive_id", "wire_contract_id"],
          "properties": {
            "primitive_id": {"const": "echo"},
            "wire_contract_id": {"const": "aneb-echo-v1"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["primitive_id", "wire_contract_id"],
          "properties": {
            "primitive_id": {"const": "token_sim"},
            "wire_contract_id": {"const": "aneb-token-task-v1"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["primitive_id", "wire_contract_id"],
          "properties": {
            "primitive_id": {"const": "download"},
            "wire_contract_id": {"const": "aneb-download-v1"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["primitive_id", "wire_contract_id"],
          "properties": {
            "primitive_id": {"const": "upload"},
            "wire_contract_id": {"const": "aneb-upload-v1"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["primitive_id", "wire_contract_id"],
          "properties": {
            "primitive_id": {"const": "udp_echo"},
            "wire_contract_id": {"const": "aneb-udp-echo-v2"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["primitive_id", "wire_contract_id"],
          "properties": {
            "primitive_id": {"const": "realtime_sim"},
            "wire_contract_id": {"const": "aneb-realtime-session-v1"}
          },
          "additionalProperties": false
        }
      ]
    },
    "execution_requirements": {
      "type": "object",
      "required": [
        "contract_id",
        "contract_version",
        "client_engine",
        "server_capability_receipt",
        "required_primitives"
      ],
      "properties": {
        "contract_id": {"const": "aneb-execution-requirements"},
        "contract_version": {"const": "1.0.0"},
        "client_engine": {
          "type": "object",
          "required": ["contract_id", "min_version", "max_version_exclusive"],
          "properties": {
            "contract_id": {
              "enum": [
                "aneb-token-simulation-engine",
                "aneb-realtime-simulation-engine",
                "aneb-network-comprehensive-engine"
              ]
            },
            "min_version": {"$ref": "#/$defs/semver"},
            "max_version_exclusive": {"$ref": "#/$defs/semver"}
          },
          "additionalProperties": false
        },
        "server_capability_receipt": {
          "type": "object",
          "required": ["contract_id", "min_version", "max_version_exclusive"],
          "properties": {
            "contract_id": {"const": "aneb-server-capability-receipt"},
            "min_version": {"$ref": "#/$defs/semver"},
            "max_version_exclusive": {"$ref": "#/$defs/semver"}
          },
          "additionalProperties": false
        },
        "required_primitives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/server_primitive"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "client_engine": {
                "properties": {
                  "contract_id": {"const": "aneb-token-simulation-engine"}
                },
                "required": ["contract_id"]
              }
            },
            "required": ["client_engine"]
          },
          "then": {
            "properties": {
              "required_primitives": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "client_engine": {
                "properties": {
                  "contract_id": {"const": "aneb-realtime-simulation-engine"}
                },
                "required": ["contract_id"]
              }
            },
            "required": ["client_engine"]
          },
          "then": {
            "properties": {
              "required_primitives": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "client_engine": {
                "properties": {
                  "contract_id": {"const": "aneb-network-comprehensive-engine"}
                },
                "required": ["contract_id"]
              }
            },
            "required": ["client_engine"]
          },
          "then": {
            "properties": {
              "required_primitives": {
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": [
        "metric_id",
        "label",
        "domain",
        "unit",
        "measurement_level",
        "formula_id",
        "aggregation",
        "direction",
        "required_for_score",
        "minimum_sample_count",
        "target_role",
        "quality_target"
      ],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "measurement_level": {"enum": ["exact", "derived", "proxy", "unsupported"]},
        "required_for_score": {"type": "boolean"},
        "minimum_sample_count": {"type": "integer", "minimum": 1},
        "quality_target": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/quality_target"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"required_for_score": {"const": true}}},
          "then": {"properties": {"quality_target": {"$ref": "#/$defs/quality_target"}}}
        }
      ],
      "additionalProperties": true
    },
    "quality_target": {
      "type": "object",
      "required": ["operator"],
      "properties": {
        "operator": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "values": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
        "policy_id": {"type": "string", "minLength": 1},
        "required_compliance_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "provenance": {"type": "string"}
      },
      "anyOf": [
        {"required": ["value"]},
        {"required": ["values"]},
        {"required": ["policy_id"]}
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
