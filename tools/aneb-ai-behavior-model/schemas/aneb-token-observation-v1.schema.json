{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aneb.local/schemas/aneb-token-observation-v1.schema.json",
  "title": "ANEB privacy-minimized Token behavior observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_contract_version",
    "observation_id",
    "subject_group_id",
    "workload_kind",
    "payload_bytes",
    "processing_delay_ms",
    "output_token_count",
    "token_intervals_ms"
  ],
  "properties": {
    "observation_contract_version": {"const": "aneb-token-observation-v1"},
    "observation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "subject_group_id": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
    "workload_kind": {"enum": ["text", "document", "image", "video"]},
    "payload_bytes": {"type": "integer", "minimum": 1},
    "processing_delay_ms": {"type": "number", "minimum": 0},
    "output_token_count": {"type": "integer", "minimum": 1},
    "token_intervals_ms": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "response_artifact_bytes": {"type": "integer", "minimum": 0}
  }
}
