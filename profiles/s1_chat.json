{
  "profile_id": "s1_chat",
  "version": "0.2.1",
  "mode_id": "token_experience",
  "kpi_set": "agent-qoe-kpi-v0.2",
  "description": "对话流（对照组）：小 prompt 上行 + 稳态 token 流下行，对标普通 chat 应用",
  "est_duration_s": 60,
  "presentation": {
    "live_metric_id": "stream_arrival_eps",
    "live_metric_label": "AI 流式到达速率",
    "live_metric_unit": "事件/秒",
    "live_window_ms": 1000,
    "ui_refresh_ms": 250,
    "metric_ids": ["N1", "N2", "T1", "T2", "T3", "T4"],
    "conclusion_policy_id": "token-experience-conclusions-v1"
  },
  "phases": [
    { "type": "clock_sync", "samples": 20 },
    { "type": "upload_burst", "bytes": 2048, "chunk_kb": 2 },
    { "type": "token_stream", "tokens": 600, "rate_tps": 40,
      "token_bytes": { "dist": "lognormal", "median": 120, "sigma": 0.6 },
      "burst": null,
      "seed": 1001 },
    { "type": "clock_sync", "samples": 20 }
  ]
}
