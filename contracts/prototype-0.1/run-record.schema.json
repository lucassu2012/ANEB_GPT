    },
    {
      "if": {
        "properties": {
          "run_status": {"const": "server_rejected"}
        },
        "required": ["run_status"]
      },
      "then": {
        "properties": {
          "failure_reason": {"const": "server_rejected"}
        }
      }
    },
    {
      "if": {
        "properties": {
