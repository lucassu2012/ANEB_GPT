        "required": ["score_eligible"]
      },
      "then": {
        "properties": {
          "task_success": {
            "const": true
          }
        },
        "required": ["task_success", "profile_manifest_sha256", "clock"]
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {"const": "interrupted"}
        },
        "required": ["run_status"]
      },
      "then": {
        "properties": {
          "task_success": {"const": false},
          "score_eligible": {"const": false},
          "terminal_receipt_valid": {"enum": [false, null]},
          "failure_reason": {"enum": ["stream_interrupted", "mandatory_metric_missing"]},
          "metrics": {
            "properties": {
              "completion_ms": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metrics": {
            "anyOf": [
              {"properties": {"ttft_ms": {"type": "number"}}},
              {"properties": {"completion_ms": {"type": "number"}}},
              {"properties": {"stream_span_ms": {"type": "number"}}},
              {"properties": {"stream_event_rate_eps": {"type": "number"}}},
              {"properties": {"stall_threshold_ms": {"type": "number"}}},
              {"properties": {"stall_count": {"type": "integer"}}},
              {"properties": {"stall_duration_ms": {"type": "number"}}},
              {"properties": {"stall_fraction": {"type": "number"}}}
            ]
          }
        },
        "required": ["metrics"]
      },
      "then": {
        "properties": {
          "clock": {
            "properties": {
              "t0_monotonic_ns": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {"const": "cancelled"}
        },
        "required": ["run_status"]
      },
      "then": {
        "properties": {
          "task_success": {"const": false},
          "score_eligible": {"const": false},
          "terminal_receipt_valid": {"enum": [false, null]},
          "failure_reason": {"const": "cancelled"},
          "metrics": {
            "properties": {
              "completion_ms": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {"enum": ["interrupted", "cancelled"]},
          "events_received": {"const": 0}
        },
        "required": ["run_status", "events_received"]
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "ttft_ms": {"type": "null"},
              "completion_ms": {"type": "null"},
              "stream_span_ms": {"type": "null"},
              "stream_event_rate_eps": {"type": "null"},
              "stall_threshold_ms": {"type": "null"},
              "stall_count": {"type": "null"},
              "stall_duration_ms": {"type": "null"},
              "stall_fraction": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {"enum": ["interrupted", "cancelled"]},
          "events_received": {"const": 1}
        },
        "required": ["run_status", "events_received"]
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "ttft_ms": {"type": "number", "exclusiveMinimum": 0},
              "completion_ms": {"type": "null"},
              "stream_span_ms": {"type": "null"},
              "stream_event_rate_eps": {"type": "null"},
              "stall_threshold_ms": {"type": "null"},
              "stall_count": {"type": "null"},
              "stall_duration_ms": {"type": "null"},
              "stall_fraction": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {"enum": ["interrupted", "cancelled"]},
          "events_received": {"minimum": 2}
        },
        "required": ["run_status", "events_received"]
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "ttft_ms": {"type": "number", "exclusiveMinimum": 0},
              "completion_ms": {"type": "null"},
              "stream_span_ms": {"type": "number", "exclusiveMinimum": 0},
              "stream_event_rate_eps": {"type": "number", "exclusiveMinimum": 0},
              "stall_threshold_ms": {"type": "number", "exclusiveMinimum": 0},
              "stall_count": {"type": "integer", "minimum": 0},
              "stall_duration_ms": {"type": "number", "minimum": 0},
              "stall_fraction": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {"const": "invalid_sequence"}
        },
        "required": ["run_status"]
      },
      "then": {
        "properties": {
          "task_success": {"const": false},
          "score_eligible": {"const": false},
          "terminal_receipt_valid": {"enum": [false, null]},
          "failure_reason": {"const": "invalid_sequence"},
          "metrics": {
            "properties": {
              "ttft_ms": {"type": "null"},
              "completion_ms": {"type": "null"},
              "stream_span_ms": {"type": "null"},
              "stream_event_rate_eps": {"type": "null"},
              "stall_threshold_ms": {"type": "null"},
              "stall_count": {"type": "null"},
              "stall_duration_ms": {"type": "null"},
              "stall_fraction": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failure_reason": {"enum": ["clock_domain_invalid", "clock_domain_mismatch"]}
        },
        "required": ["failure_reason"]
      },
      "then": {
        "properties": {
          "task_success": {"const": false},
          "score_eligible": {"const": false},
          "terminal_receipt_valid": {"enum": [false, null]},
          "metrics": {
            "properties": {
              "ttft_ms": {"type": "null"},
              "completion_ms": {"type": "null"},
              "stream_span_ms": {"type": "null"},
              "stream_event_rate_eps": {"type": "null"},
              "stall_threshold_ms": {"type": "null"},
              "stall_count": {"type": "null"},
              "stall_duration_ms": {"type": "null"},
              "stall_fraction": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
