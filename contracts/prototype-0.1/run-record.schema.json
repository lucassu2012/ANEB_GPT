{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aneb.local/schemas/prototype-0.1/run-record.schema.json",
  "title": "ANEB Prototype 0.1 canonical run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "run_id",
    "campaign_mode",
    "run_index",
    "profile_manifest_sha256",
    "condition",
    "run_status",
    "task_success",
    "clock",
    "attempt_started_at_utc",
    "attempt_ended_at_utc",
    "events_expected",
    "events_received",
    "metrics",
    "schedule_hash",
    "terminal_receipt_valid",
    "score_eligible",
    "failure_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "aneb-prototype-run-record-0.1"
    },
    "campaign_id": {
      "$ref": "#/$defs/id"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "campaign_mode": {
      "enum": ["quick", "acceptance"]
    },
    "run_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "profile_manifest_sha256": {
      "const": "44393ddd5ed11a5091038a85d08ab65ee91a8566997e837d2c40fd3add57d5dc"
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "nominal_interval_ms"],
      "properties": {
        "id": {
          "enum": ["baseline_v0.1", "slow_v0.1", "unstable_v0.1"]
        },
        "version": {
          "const": "0.1"
        },
        "nominal_interval_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "unit", "epoch", "includes_deep_sleep", "domain_id", "t0_monotonic_ns", "t0_boundary", "event_boundary", "done_boundary"],
      "properties": {
        "source": {"const": "android.os.SystemClock.elapsedRealtimeNanos"},
        "unit": {"const": "ns"},
        "epoch": {"const": "device_boot"},
        "includes_deep_sleep": {"const": true},
        "domain_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$"},
        "t0_monotonic_ns": {"type": ["integer", "null"], "minimum": 0},
        "t0_boundary": {"const": "immediately_before_transport_dispatch"},
        "event_boundary": {"const": "after_complete_sse_content_event_decode_and_identity_validation"},
        "done_boundary": {"const": "after_complete_done_event_decode_and_identity_validation"}
      }
    },
    "run_status": {
      "enum": [
        "complete",
        "interrupted",
        "incompatible",
        "invalid_sequence",
        "cancelled",
        "ttft_timeout",
        "server_rejected",
        "not_started"
      ]
    },
    "task_success": {
      "type": "boolean"
    },
    "attempt_started_at_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "attempt_ended_at_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "events_expected": {
      "const": 120
    },
    "events_received": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
              "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttft_ms",
        "completion_ms",
        "stream_span_ms",
        "stream_event_rate_eps",
        "stall_threshold_ms",
        "stall_count",
        "stall_duration_ms",
        "stall_fraction"
      ],
      "properties": {
        "ttft_ms": {
          "$ref": "#/$defs/nullableNonNegativeNumber"
        },
        "completion_ms": {
          "$ref": "#/$defs/nullableNonNegativeNumber"
        },
        "stream_span_ms": {
          "$ref": "#/$defs/nullableNonNegativeNumber"
        },
        "stream_event_rate_eps": {
          "$ref": "#/$defs/nullableNonNegativeNumber"
        },
        "stall_threshold_ms": {
          "$ref": "#/$defs/nullableNonNegativeNumber"
        },
        "stall_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "stall_duration_ms": {
          "$ref": "#/$defs/nullableNonNegativeNumber"
        },
        "stall_fraction": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "schedule_hash": {
      "$ref": "#/$defs/hash"
    },
    "terminal_receipt_valid": {
      "type": ["boolean", "null"]
    },
    "score_eligible": {
      "type": "boolean"
    },
    "failure_reason": {
      "type": ["string", "null"],
      "enum": [
        "contract_mismatch",
        "invalid_sequence",
        "stream_interrupted",
        "cancelled",
        "ttft_timeout",
        "server_rejected",
        "not_started",
        "clock_domain_invalid",
        "clock_domain_mismatch",
        "mandatory_metric_missing",
        "invalid_evidence",
        null
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableNonNegativeNumber": {
      "type": ["number", "null"],
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "campaign_mode": {"const": "quick"}
        },
        "required": ["campaign_mode"]
      },
      "then": {
        "properties": {
          "run_index": {"maximum": 3}
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_mode": {"const": "acceptance"}
        },
        "required": ["campaign_mode"]
      },
      "then": {
        "properties": {
          "run_index": {"maximum": 9}
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_mode": {"const": "quick"},
          "run_index": {"const": 1}
        },
        "required": ["campaign_mode", "run_index"]
      },
      "then": {
        "properties": {
          "condition": {"properties": {"id": {"const": "baseline_v0.1"}}},
          "schedule_hash": {"const": "46eced73d2fbc886040a3357f84551d424a95e15d6e9e69c16958f6e52e33d7e"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_mode": {"const": "quick"},
          "run_index": {"const": 2}
        },
        "required": ["campaign_mode", "run_index"]
      },
      "then": {
        "properties": {
          "condition": {"properties": {"id": {"const": "slow_v0.1"}}},
          "schedule_hash": {"const": "b51b27fe8332b3fc8a97472a44312b3001ccd54364a61ed8799816c299d27062"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_mode": {"const": "quick"},
          "run_index": {"const": 3}
        },
        "required": ["campaign_mode", "run_index"]
      },
      "then": {
        "properties": {
          "condition": {"properties": {"id": {"const": "unstable_v0.1"}}},
          "schedule_hash": {"const": "d11dce2a877d7c3772a4552f2d922d5f96730c9a01bb829f0203c65b110a8c58"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_mode": {"const": "acceptance"},
          "run_index": {"enum": [1, 4, 7]}
        },
        "required": ["campaign_mode", "run_index"]
      },
      "then": {
        "properties": {
          "condition": {"properties": {"id": {"const": "baseline_v0.1"}}},
          "schedule_hash": {"const": "46eced73d2fbc886040a3357f84551d424a95e15d6e9e69c16958f6e52e33d7e"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_mode": {"const": "acceptance"},
          "run_index": {"enum": [2, 5, 8]}
        },
        "required": ["campaign_mode", "run_index"]
      },
      "then": {
        "properties": {
          "condition": {"properties": {"id": {"const": "slow_v0.1"}}},
          "schedule_hash": {"const": "b51b27fe8332b3fc8a97472a44312b3001ccd54364a61ed8799816c299d27062"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "campaign_mode": {"const": "acceptance"},
          "run_index": {"enum": [3, 6, 9]}
        },
        "required": ["campaign_mode", "run_index"]
      },
      "then": {
        "properties": {
          "condition": {"properties": {"id": {"const": "unstable_v0.1"}}},
          "schedule_hash": {"const": "d11dce2a877d7c3772a4552f2d922d5f96730c9a01bb829f0203c65b110a8c58"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "properties": {"id": {"const": "baseline_v0.1"}}
          }
        },
        "required": ["condition"]
      },
      "then": {
        "properties": {
          "condition": {
            "properties": {"nominal_interval_ms": {"const": 50}}
          },
          "schedule_hash": {"const": "46eced73d2fbc886040a3357f84551d424a95e15d6e9e69c16958f6e52e33d7e"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "properties": {"id": {"const": "slow_v0.1"}}
          }
        },
        "required": ["condition"]
      },
      "then": {
        "properties": {
          "condition": {
            "properties": {"nominal_interval_ms": {"const": 125}}
          },
          "schedule_hash": {"const": "b51b27fe8332b3fc8a97472a44312b3001ccd54364a61ed8799816c299d27062"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "condition": {
            "properties": {"id": {"const": "unstable_v0.1"}}
          }
        },
        "required": ["condition"]
      },
      "then": {
        "properties": {
          "condition": {
            "properties": {"nominal_interval_ms": {"const": 65}
            }
          },
          "schedule_hash": {"const": "d11dce2a877d7c3772a4552f2d922d5f96730c9a01bb829f0203c65b110a8c58"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {"const": "complete"}
        },
        "required": ["run_status"]
      },
      "then": {
        "properties": {
          "task_success": {"const": true},
          "events_received": {"const": 120},
          "terminal_receipt_valid": {"const": true},
          "failure_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_success": {
            "const": true
          }
        },
        "required": ["task_success"]
      },
      "then": {
        "properties": {
          "score_eligible": {"const": true},
          "run_status": {
            "const": "complete"
          },
          "events_received": {
            "const": 120
          },
          "terminal_receipt_valid": {
            "const": true
          },
          "attempt_started_at_utc": {"type": "string", "format": "date-time"},
          "attempt_ended_at_utc": {"type": "string", "format": "date-time"},
          "metrics": {
            "required": [
              "ttft_ms",
              "completion_ms",
              "stream_span_ms",
              "stream_event_rate_eps",
              "stall_threshold_ms",
              "stall_count",
              "stall_duration_ms",
              "stall_fraction"
            ],
            "properties": {
              "ttft_ms": {"type": "number", "exclusiveMinimum": 0},
              "completion_ms": {"type": "number", "exclusiveMinimum": 0},
              "stream_span_ms": {"type": "number", "exclusiveMinimum": 0},
              "stream_event_rate_eps": {"type": "number", "exclusiveMinimum": 0},
              "stall_threshold_ms": {"type": "number", "exclusiveMinimum": 0},
              "stall_count": {"type": "integer", "minimum": 0},
              "stall_duration_ms": {"type": "number", "minimum": 0},
              "stall_fraction": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "clock": {
            "properties": {
              "t0_monotonic_ns": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "score_eligible": {
            "const": true
