{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aneb.local/schemas/prototype-0.1/capabilities.schema.json",
  "title": "ANEB Prototype 0.1 capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_version",
    "protocol_version",
    "server_version",
    "server_binary_sha256",
    "claim_scope",
    "evidence_mode",
    "impairment_layer",
    "profile_manifest_sha256",
    "workload",
    "conditions",
    "evidence_schema_version",
    "score_policy_id",
    "terminal_receipt_version"
  ],
  "properties": {
    "schema_version": {
      "const": "aneb-prototype-capabilities-0.1"
    },
    "product_version": {
      "const": "prototype-0.1"
    },
    "protocol_version": {
      "const": "prototype-stream-0.1"
    },
    "server_version": {
      "type": "string",
      "minLength": 1
    },
    "server_binary_sha256": {
      "$ref": "#/$defs/hash"
    },
    "claim_scope": {
      "const": "application_end_to_end_to_probe_node"
    },
    "evidence_mode": {
      "const": "synthetic_application_impairment"
    },
    "impairment_layer": {
      "const": "application"
    },
    "profile_manifest_sha256": {
      "const": "592f44bbc841c3d6c734702775c7c2faf81fa7192937279c1e584bf3889ae63b"
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "content_event_count"],
      "properties": {
        "id": {
          "const": "streaming_text_reference_v0.1"
        },
        "version": {
          "const": "0.1"
        },
        "content_event_count": {
          "const": 120
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "nominal_interval_ms", "schedule_sha256"],
          "properties": {
            "id": {"const": "baseline_v0.1"},
            "version": {"const": "0.1"},
            "nominal_interval_ms": {"const": 50},
            "schedule_sha256": {"const": "46eced73d2fbc886040a3357f84551d424a95e15d6e9e69c16958f6e52e33d7e"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "nominal_interval_ms", "schedule_sha256"],
          "properties": {
            "id": {"const": "slow_v0.1"},
            "version": {"const": "0.1"},
            "nominal_interval_ms": {"const": 125},
            "schedule_sha256": {"const": "b51b27fe8332b3fc8a97472a44312b3001ccd54364a61ed8799816c299d27062"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "nominal_interval_ms", "schedule_sha256"],
          "properties": {
            "id": {"const": "unstable_v0.1"},
            "version": {"const": "0.1"},
            "nominal_interval_ms": {"const": 65},
            "schedule_sha256": {"const": "d11dce2a877d7c3772a4552f2d922d5f96730c9a01bb829f0203c65b110a8c58"}
          }
        }
      ],
      "items": false
    },
    "evidence_schema_version": {
      "const": "aneb-prototype-evidence-0.1"
    },
    "score_policy_id": {
      "const": "rpi-0.1"
    },
    "terminal_receipt_version": {
      "const": "prototype-terminal-receipt-0.1"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
