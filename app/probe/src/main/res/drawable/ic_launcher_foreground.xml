<?xml version="1.0" encoding="utf-8"?>
<!-- token 脉冲环品牌图标前景（自适应图标 108dp 画布，安全区 ~66dp 居中）：
     底环（暗）+ 品牌钴紫蓝弧 + 优绿短弧（"已点亮 token"）+ 白色播放三角。
     纯本地矢量，无 GMS/PNG 资源依赖（华为即装即用）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底环 -->
    <path
        android:strokeColor="#232C3D"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,24 A30,30 0 1 1 53.99,24" />

    <!-- 品牌弧（顶端起，顺时针约 240°） -->
    <path
        android:strokeColor="#5D5FEF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M54,24 A30,30 0 1 1 24.5,60" />

    <!-- 优绿短弧（收尾"已点亮 token"） -->
    <path
        android:strokeColor="#2FD98A"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M24.5,60 A30,30 0 0 0 39,80" />

    <!-- 中心播放三角（白） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,43 L48,65 L67,54 Z" />
</vector>
